# Copy to backend/.env and fill in. Never commit .env.
DEBUG=1
SECRET_KEY=change-me
# PostgreSQL (leave unset to use the local SQLite file)
# DATABASE_URL=postgres://nyumba:YOUR_PASSWORD@localhost:5432/nyumba
FRONTEND_URL=http://localhost:3000
# Payments: "sandbox" (local simulator) or "flutterwave"
PAYMENT_GATEWAY=sandbox
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_WEBHOOK_HASH=a-long-random-string-you-also-set-in-the-flutterwave-dashboard
